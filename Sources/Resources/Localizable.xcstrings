    "tool.ultraDefrag.principle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merges the small splinters without moving the big blocks, and evicts nobody."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recolle les petits éclats sans déplacer les gros blocs, et n'évacue personne."
          }
        }
      }
    },
