    "pass.witness.note.fatCheap" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On FAT, fragmentation costs almost nothing at boot: these files were written in one piece by the installer, on an empty disk. What makes the noise is the order they are asked for in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur FAT, la fragmentation ne coûte presque rien au démarrage : ces fichiers ont été écrits d'un seul tenant par l'installeur, sur un disque vide. Ce qui fait le bruit, c'est l'ordre dans lequel on les demande."
          }
        }
      }
    },
    "pass.witness.note.fatCostly" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here, where the files sit costs %@: more than a FAT boot usually pays. Not every file read kept the place the installer gave it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, la place des fichiers coûte %@ : plus que ce qu'un démarrage FAT paie d'ordinaire. Les fichiers lus n'ont pas tous gardé la place que l'installeur leur avait donnée."
          }
        }
      }
    },
    "pass.witness.note.ntfsLoses" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The witness loses: NTFS picks the hole that fits rather than the first one it meets, and its layout beats a tidying that piles everything up in directory order."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le témoin perd : NTFS choisit le trou qui convient plutôt que le premier venu, et sa disposition bat ici un rangement qui empile tout dans l'ordre du répertoire."
          }
        }
      }
    },
    "pass.witness.note.ntfsWins" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On NTFS the witness does not always win; here it wins by %@ %%. It does not measure fragmentation alone, but what the real placement of the files costs against a naive tidying."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur NTFS, le témoin ne gagne pas toujours ; ici il gagne %@ %%. Il ne mesure pas la fragmentation seule, mais ce que coûte la place réelle des fichiers face à un rangement naïf."
          }
        }
      }
    },
    "pass.witness.note.pending" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The witness reads exactly the same files, each in one piece and packed against the start of the volume. It was simulated before the listening; the gap reads at the end."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le témoin lit exactement les mêmes fichiers, chacun d'un seul tenant et tassé contre le début du volume. Il a été simulé avant l'écoute ; l'écart se lit à la fin."
          }
        }
      }
    },
