    "onboarding.headphones.lead" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A built-in speaker erases the low end of the rotation and the arm's transients. On headphones, a short seek and a full stroke do not sound alike."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un haut-parleur intégré efface le grave de la rotation et les transitoires du bras. Au casque, un seek court et une pleine course ne sonnent pas pareil."
          }
        }
      }
    },
