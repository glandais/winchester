      }
    },
    "tool.frontierCompaction.principle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packs the volume in the order it is in: files slide towards the start in runs, and no write ever lands on data that is still referenced."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasse le volume dans l'ordre où il est : les fichiers glissent vers le début par tronçons, et aucune écriture ne tombe sur une donnée encore référencée."
          }
        }
      }
    },
    "tool.frontierCompaction.sound" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short shuttle working its way up the platter; long on a full disk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une navette courte qui remonte le plateau ; long sur un disque plein."
          }
        }
      }
    },
