      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packs everything to the start of the disk, in tree order, evicting whatever is in the way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasse tout au début du disque, dans l'ordre de l'arborescence, en évacuant ce qui gêne."
          }
        }
      }
    },
    "tool.windows95.sound" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constant back-and-forth, and a “clack” at the edge of the platter for every file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des allers-retours permanents, et un « clac » au bord du plateau à chaque fichier."
          }
        }
      }
    },
