      }
    },
    "scenario.boot.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The boot is not described in fractions of the platter but in files: %1$lld files of the catalogue are opened and read where the allocator left them. The system counts %2$@ of computing between two reads; everything the pass lasts beyond that comes from the disk. The same contents, never fragmented, would boot in %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le démarrage n'est pas décrit en fractions du plateau mais en fichiers : %1$lld fichiers du catalogue sont ouverts et lus là où l'allocateur les a laissés. Le système compte %2$@ de calcul entre deux lectures ; tout ce que la passe dure en plus vient du disque. Le même contenu jamais fragmenté démarrerait en %3$@."
          }
        }
      }
    },
    "scenario.boot.summary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Booting Windows 98 SE then Office 97, on “Office work, 1999” from the catalogue: a 4.2 GB FAT32 aged by two years of office work"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrage de Windows 98 SE puis d'Office 97, sur « Secrétariat, 1999 » du catalogue : un FAT32 de 4,2 Go vieilli par deux ans de bureautique"
          }
        }
      }
    },
    "scenario.boot.summary.after" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "after %@ went through, "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "après le passage de %@, "
          }
        }
      }
    },
    "scenario.boot.summary.fresh" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "right after the installation, "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "juste après l'installation, "
          }
        }
      }
    },
    "scenario.boot.summary.head" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Booting %1$@%2$@, "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrage de %1$@%2$@, "
          }
        }
      }
    },
    "scenario.day.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”, day %2$lld of %3$lld: the volume is %4$lld %% full, %5$lld files in pieces. The day is replayed just as the profile's history describes it — what it writes comes from the history, what it reads from what the activity implies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ », jour %2$lld sur %3$lld : le volume est à %4$lld %%, %5$lld fichiers en morceaux. La journée est rejouée telle que l'histoire du profil la décrit — ce qu'elle écrit vient d'elle, ce qu'elle lit vient de ce que l'activité suppose."
          }
        }
      }
    },
    "scenario.defrag.fallbackSummary" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
