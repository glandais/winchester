    "allocator.bestFit" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS picks the hole that fits rather than the first one it meets, and keeps data away from its MFT zone: only %1$@ of the fragmentable files are in pieces. Those are in many — the worst counts %2$@ — and they are what carries the average to %3$@ pieces per file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS choisit le trou qui convient plutôt que le premier venu, et tient les données à l'écart de sa zone MFT : seuls %1$@ des fichiers fragmentables sont en morceaux. Ceux-là le sont beaucoup — le pire en compte %2$@ —, et ce sont eux qui portent la moyenne à %3$@ morceaux par fichier."
          }
        }
      }
    },
    "allocator.bestFit.clean" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS picks the hole that fits rather than the first one it meets, and keeps data away from its MFT zone: not one file on this volume is in pieces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS choisit le trou qui convient plutôt que le premier venu, et tient les données à l'écart de sa zone MFT : aucun fichier de ce volume n'est en morceaux."
          }
        }
      }
    },
    "allocator.firstFit" : {
      "comment" : "Ce que l'allocateur a fait de ce volume",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MS-DOS serves the first free cluster from the start of the volume, on every write: holes are plugged at once and recent files are chopped up. The %1$@ of slack comes from the %2$lld KB clusters the volume size imposes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MS-DOS sert le premier cluster libre à partir du début du volume, à chaque écriture : les trous se rebouchent aussitôt et les fichiers récents sont hachés. Le slack de %1$@ vient des clusters de %2$lld Ko, que la taille du volume impose."
          }
        }
      }
    },
    "allocator.nextFit" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The driver resumes at the last allocated cluster: writing is clean as long as the cursor moves forward, then it wraps to the start of the volume and passes back over holes left months earlier. %@ holes remain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote reprend au dernier cluster alloué : l'écriture est propre tant que le curseur avance, puis il revient au début du volume et repasse par-dessus des trous laissés des mois plus tôt. %@ trous subsistent."
          }
        }
      }
    },
