            "state" : "translated",
            "value" : "Many short requests; far fewer pieces at the end."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beaucoup de requêtes courtes ; bien moins de morceaux à la fin."
