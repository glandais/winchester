    "error.unusableClusterSize" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-byte cluster: smaller than a sector"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cluster de %lld octets : plus petit qu'un secteur"
          }
        }
      }
    },
    "explanation.edgeReturn.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On FAT, every committed move rewrites both copies of the allocation table, at the very start of the partition, then the file's entry in its directory. The arm comes back to the edge roughly once per file: that is the sharp “clack” that paces a Windows 95 pass."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur FAT, chaque déplacement validé réécrit les deux copies de la table d'allocation, au tout début de la partition, puis l'entrée du fichier dans son répertoire. Le bras revient au bord à peu près une fois par fichier : c'est le « clac » franc qui rythme une passe de Windows 95."
          }
        }
      }
    },
    "explanation.edgeReturn.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The return to the edge"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retour au bord"
          }
        }
      }
    },
    "explanation.evacuations.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The place a file has to go is nearly always taken: the occupant first leaves for the far end of the volume, and will be moved again when its turn comes. It is that back-and-forth, more than the amount of data, that makes a pass long. A tool that evicts nobody counts zero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La place où doit aller un fichier est presque toujours occupée : l'occupant part d'abord au fond du volume, et sera redéplacé quand viendra son tour. C'est ce va-et-vient, plus que la quantité de données, qui fait durer une passe. Un outil qui ne déloge personne en compte zéro."
          }
        }
      }
    },
    "explanation.evacuations.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evacuations"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les évacuations"
          }
        }
      }
    },
    "explanation.fragmentedVsPieces.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file counts as “fragmented” the moment it sits in two pieces: brought down from 40 pieces to 2, it still is. The share of fragmented files can therefore stall while the number of pieces collapses. The two figures are read together."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier est « fragmenté » dès qu'il tient en deux morceaux : ramené de 40 morceaux à 2, il l'est encore. Le taux de fichiers fragmentés peut donc stagner pendant que le nombre de morceaux s'effondre. Les deux chiffres se lisent ensemble."
          }
        }
      }
    },
    "explanation.fragmentedVsPieces.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmented, or in pieces"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmentés ou en morceaux"
          }
        }
      }
    },
    "explanation.group.arm" : {
      "comment" : "Thème des fiches, dans les Réglages",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The arm and the boot"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bras et le démarrage"
          }
        }
      }
    },
    "explanation.group.sound" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sound"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le son"
          }
        }
      }
    },
    "explanation.group.volume" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volume"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume"
          }
        }
      }
    },
    "explanation.haptics.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Taptic Engine gets the same cues as the sound: a thud as the arm leaves, a rumble along its travel, a thud on arrival. Trains close together become a continuous texture rather than a burst of thuds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Taptic Engine reçoit les mêmes repères que le son : un choc au départ du bras, un grondement pendant sa course, un choc à l'arrivée. Les trains rapprochés deviennent une texture continue plutôt qu'une salve de chocs."
          }
        }
      }
    },
    "explanation.haptics.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your hand"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la main"
          }
        }
      }
    },
    "explanation.headSound.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bank of fixed-frequency resonators, around 4.5 and 5.5 kHz: only the excitation varies with distance, the actuator's resonances do not change with speed. Two seeks close together do not start two sounds: they form a single train, closed by a thud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un banc de résonateurs à fréquences fixes, vers 4,5 et 5,5 kHz : seule l'excitation varie avec la distance, les résonances de l'actionneur ne changent pas avec la vitesse. Deux seeks rapprochés ne relancent pas deux sons : ils forment un seul train, fermé par un choc."
          }
        }
      }
    },
    "explanation.headSound.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timbre of the arm"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timbre du bras"
          }
        }
      }
    },
    "explanation.installation.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk's first day, replayed: every file is written where the allocator put it. The source throttles the copy — a floppy reads at 45 KB/s, a 24x CD at 3.6 MB/s. Installers first extract their archives and read them back while copying: that is the back-and-forth that crackles. Then they delete them, and leave the first holes. Every restart reads back what was just laid down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier jour du disque, rejoué : chaque fichier est écrit là où l'allocateur l'a posé. La source bride la copie — une disquette se lit à 45 Ko/s, un CD 24x à 3,6 Mo/s. Les installeurs extraient d'abord leurs archives et les relisent en copiant : c'est le va-et-vient qui crépite. Puis ils les effacent, et laissent les premiers trous. Chaque redémarrage relit ce qui vient d'être posé."
          }
        }
      }
    },
    "explanation.installation.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installation"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'installation"
          }
        }
      }
    },
    "explanation.mftZone.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS reserves 12.5% of the volume so its file table can grow, and writes there only once the rest is full. Opening a file reads its record back from that table, at the head of the volume: with no prefetcher, that makes two sweeps of the arm per file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS réserve 12,5 % du volume pour que sa table de fichiers puisse grandir, et n'y écrit qu'une fois le reste plein. Ouvrir un fichier relit sa fiche dans cette table, en tête du volume : sans préchargeur, cela fait deux courses du bras par fichier."
          }
        }
      }
    },
    "explanation.mftZone.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The MFT zone"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zone MFT"
          }
        }
      }
    },
    "explanation.nextFit.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under Windows 95 and 98, VFAT and FAT32 resume from the last allocated cluster. As long as that cursor moves forward, files stay clean. Once it reaches the end of the volume it wraps around and fills the holes left months earlier: that is where files get chopped up, in waves. MS-DOS, on FAT16, serves the first free cluster from the start instead: every hole is plugged at once, and recent files shatter into crumbs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous Windows 95 et 98, VFAT et FAT32 repartent du dernier cluster alloué. Tant que ce curseur avance, les fichiers sont propres. Arrivé au bout du volume, il revient au début et comble les trous laissés des mois plus tôt : c'est là que les fichiers se hachent, par vagues. MS-DOS, en FAT16, sert au contraire le premier cluster libre depuis le début : chaque trou est rebouché aussitôt, et les fichiers récents s'éclatent en miettes."
          }
        }
      }
    },
    "explanation.nextFit.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next-fit allocator"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allocateur next-fit"
          }
        }
      }
    },
    "explanation.pagefile.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows has it open: the defragmenter cannot move it and tidies around it. It is the red block that never moves on the map."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows l'a ouvert : le défragmenteur ne peut pas le déplacer et range tout autour. C'est le bloc rouge qui ne bouge jamais sur la carte."
          }
        }
      }
    },
    "explanation.pagefile.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The page file"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier d'échange"
          }
        }
      }
    },
    "explanation.prefetch.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows XP and Vista sort the list of files read at boot by position on the disk, and read it back in a single sweep of the arm, together with the MFT records that describe them. Before XP there was no prefetcher: the arm follows the order in which the system asks for its files, not their position."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows XP et Vista rangent la liste des fichiers à lire au démarrage par position sur le disque, et la relisent d'une seule course du bras, avec les fiches de la MFT qui les décrivent. Avant XP, pas de préchargeur : le bras suit l'ordre dans lequel le système demande ses fichiers, pas leur position."
          }
        }
      }
    },
    "explanation.prefetch.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prefetcher"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le préchargeur"
          }
        }
      }
    },
    "explanation.rotation.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hum is computed from the spindle speed, for lack of a recording. It is the weak link of the model: projects that sound right start from a real recording."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ronronnement est calculé à partir du régime, faute d'enregistrement. C'est le maillon faible du modèle : les projets qui sonnent juste bouclent un enregistrement réel."
          }
        }
      }
    },
    "explanation.rotation.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hum"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ronronnement"
          }
        }
      }
    },
    "explanation.seeAlso" : {
      "comment" : "En-tête, en capitales",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SEE ALSO"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOIR AUSSI"
          }
        }
      }
    },
    "explanation.seekLaw.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For short seeks, the time grows as the square root of the distance; beyond that it becomes proportional. Two short seeks therefore take longer than a single one covering the same total distance, and sound different."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les seeks courts, le temps croît comme la racine de la distance ; au-delà, il devient proportionnel. Deux seeks courts prennent donc plus longtemps qu'un seul de même distance totale, et sonnent autrement."
          }
        }
      }
    },
    "explanation.seekLaw.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The seek law"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La loi de seek"
          }
        }
      }
    },
    "explanation.why" : {
      "comment" : "Étiquette du ⓘ posé à côté d'un chiffre",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi : %@"
          }
        }
      }
    },
    "explanation.witness.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same files, each in one piece, packed against the start of the volume. The gap measures what the real placement costs. On FAT it is almost nil; on NTFS, the witness sometimes loses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mêmes fichiers, chacun d'un seul tenant, tassés contre le début du volume. L'écart mesure ce que coûte le placement réel. Sur FAT il est presque nul ; sur NTFS, le témoin perd parfois."
          }
        }
      }
    },
    "explanation.witness.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The witness"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le témoin"
          }
        }
      }
    },
