    "compare.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lowest value is marked on each line; no line outranks another. A tool that tidies better and a tool that goes faster are not doing the same job: it depends on what you want to hear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur la plus basse est marquée sur chaque ligne ; aucune ligne ne l'emporte sur une autre. Un outil qui range mieux et un outil qui va plus vite ne font pas le même travail : ça dépend de ce qu'on veut entendre."
          }
        }
      }
    },
