    "scenario.defrag.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The files keep exactly the clusters the allocator gave them — that is the volume being defragmented, not an approximation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers gardent exactement les clusters que l'allocateur leur a donnés — c'est ce volume-là qui est défragmenté, pas une approximation."
          }
        }
      }
    },
