    "tool.fragmentMerge.origin" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "written for Winchester · NTFS only"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "écrit pour Winchester · NTFS uniquement"
          }
        }
      }
    },
    "tool.fragmentMerge.principle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only copies the small pieces, next to their big neighbour or into the nearest hole, and gathers the free space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne recopie que les petits morceaux, contre leur gros voisin ou dans le trou le plus proche, et regroupe l'espace libre."
          }
        }
      }
    },
    "tool.fragmentMerge.sound" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocks read piece by piece then written in one go, and a checkpoint every sixteen moves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des blocs lus morceau par morceau puis écrits d'un coup, et un point de contrôle tous les seize déplacements."
          }
        }
      }
    },
